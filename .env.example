# Copy to .env for local development. Never commit a real .env.
# Only variables actually read by the code are listed.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# MongoDB connection string (required).
MONGODB_URI=mongodb://127.0.0.1:27017/folded_dev

# Optional log level: fatal | error | warn | info | debug | trace | silent
# Defaults by environment (production=info, development=debug, test=silent).
# LOG_LEVEL=debug

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Force the Secure flag on auth cookies: true | false
# Defaults to true in production, false otherwise. Leave unset locally.
# COOKIE_SECURE=false

# Evidence photo storage (S3-compatible). When these are unset, uploads are
# disabled and a stub is used. Set all three of bucket/key/secret to enable.
# S3_BUCKET=folded-evidence
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # for MinIO / DigitalOcean Spaces etc.
# EVIDENCE_URL_TTL_SECONDS=900

# --- Seed script (pnpm seed) ---
# Admin credentials are REQUIRED to seed; choose a strong password, never a
# default. Other users are optional and only created when both vars are set.
# SEED_ADMIN_PHONE=01700000000
# SEED_ADMIN_PASSWORD=
# SEED_OPS_PHONE=
# SEED_OPS_PASSWORD=
# SEED_PARTNER_STAFF_PHONE=
# SEED_PARTNER_STAFF_PASSWORD=
# SEED_RIDER_PHONE=
# SEED_RIDER_PASSWORD=
# NOTE: the seed publishes PLACEHOLDER prices/rates — replace them before launch.
