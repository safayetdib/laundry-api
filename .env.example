# Copy to .env for local development. Never commit a real .env.
# Only variables actually read by the code are listed.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# MongoDB connection string (required).
MONGODB_URI=mongodb://127.0.0.1:27017/folded_dev

# Optional log level: fatal | error | warn | info | debug | trace | silent
# Defaults by environment (production=info, development=debug, test=silent).
# LOG_LEVEL=debug

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Force the Secure flag on auth cookies: true | false
# Defaults to true in production, false otherwise. Leave unset locally.
# COOKIE_SECURE=false
